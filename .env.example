# Root Docker/compose variables.
# Copy to .env before running `docker compose up --build`.

COMPOSE_PROJECT_NAME=deliveryapp
API_PORT=4000
WEB_PORT=8080
MONGO_PORT=27017

# Frontend build-time values
VITE_API_URL=http://localhost:4000/api
VITE_RAZORPAY_KEY_ID=

# Backend runtime values
CLIENT_URL=http://localhost:8080
JWT_SECRET=replace-with-a-long-secret
MONGODB_URI=mongodb://mongodb:27017/karnataka-grocery-mvp
REDIS_URL=
ADMIN_PHONE=9876500000
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
